{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "itinerary",
  "type": "object",
  "required": ["meta", "days"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "start_date"],
      "properties": {
        "title": { "type": "string" },
        "start_date": { "type": "string" },
        "generated_at": { "type": "string" },
        "preview_mode": { "type": "boolean", "description": "true = 无高德核验的预览模式，渲染需持续显示横幅" },
        "degraded": { "type": "array", "items": { "type": "string" } }
      }
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["day_index", "date", "segments", "stops", "overnight"],
        "properties": {
          "day_index": { "type": "integer" },
          "date": { "type": "string" },
          "note": { "type": "string", "description": "当日一句话备注，显示在当天卡片正文（警告之后、途经点之前）" },
          "tips": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "description": "折叠展示的当日建议，键即标签（如 温度/穿衣/拍摄/美食），值为文本"
          },
          "fidelity": {
            "type": "string",
            "enum": ["skeleton", "filled", "verified"],
            "description": "本日分辨率：骨架（仅过夜点+路耗）/已填充（景点动线齐）/已核验（过完 L3）"
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": { "$ref": "#/definitions/place" },
                "to": { "$ref": "#/definitions/place" },
                "distance_km": { "type": "number" },
                "duration_min": { "type": "number" },
                "geometry": {
                  "type": "array",
                  "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
                  "description": "真实道路几何 [lng,lat] 点列，fetch_geometry.py 写入（抽稀后）；量大，模型不要读写此字段"
                },
                "special": { "type": "string", "description": "特殊路段名（如某风景公路），地图上独立配色并在 tooltip 标注" },
                "claimed": {
                  "type": "object",
                  "properties": {
                    "distance_km": { "type": "number" },
                    "duration_min": { "type": "number" }
                  },
                  "description": "doc 模式：攻略原文声称的数字，解析时写入且实测后保留，用于'原文称 X 实测 Y'对照"
                },
                "roads": { "type": "array", "items": { "type": "string" } },
                "refuel_points": {
                  "type": "array",
                  "items": {
                    "allOf": [
                      { "$ref": "#/definitions/place" },
                      { "properties": { "km_from_start": { "type": "number" } } }
                    ]
                  }
                }
              }
            }
          },
          "stops": {
            "type": "array",
            "items": {
              "allOf": [
                { "$ref": "#/definitions/place" },
                {
                  "properties": {
                    "elevation_m": { "type": ["number", "null"] },
                    "visit_min": { "type": "number" },
                    "advisories": { "type": "array" }
                  }
                }
              ]
            }
          },
          "overnight": {
            "allOf": [
              { "$ref": "#/definitions/place" },
              { "properties": { "elevation_m": { "type": ["number", "null"] } } }
            ]
          },
          "claims": {
            "type": "array",
            "items": { "$ref": "#/definitions/claim" },
            "description": "仅涉及本日的核验主张；跨天/全程的放顶层 claims"
          },
          "warnings": { "type": "array" }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/definitions/claim" },
      "description": "全程级核验主张（如某公路季节性开放）"
    },
    "plan_b": { "type": "array" },
    "change_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": { "type": "string" },
          "summary": { "type": "string" },
          "affected_days": { "type": "array", "items": { "type": "integer" } },
          "distance_km_delta": { "type": "number" },
          "duration_min_delta": { "type": "number" },
          "warnings_delta": { "type": "integer" }
        }
      },
      "description": "diff_itinerary.py 追加；渲染的\"本次变更\"块读取最后一条"
    }
  },
  "definitions": {
    "place": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "lnglat": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "poi_id": { "type": "string" },
        "source": {
          "type": "string",
          "enum": ["amap", "doc_claim", "llm_guess", "unverified"],
          "description": "amap=高德核验；doc_claim=来自用户攻略原文；llm_guess=模型构思未核验；unverified=其他未核验"
        },
        "pinned": { "type": "boolean", "description": "用户确认过的元素，非用户明说不改动" },
        "weather": { "type": "string", "description": "该点即时/预报天气一句话（与 day.tips 的温度建议是两回事），POI 弹窗展示" }
      }
    },
    "claim": {
      "type": "object",
      "required": ["claim", "type", "verdict"],
      "properties": {
        "claim": { "type": "string", "description": "被核验的主张原文或归一化表述" },
        "type": {
          "type": "string",
          "enum": ["gate_access", "shuttle_transfer", "reservation", "permit", "seasonal_road", "phenology", "refuel", "altitude", "other"],
          "description": "对应 checklists/categories.md 的 8 类 + other"
        },
        "verdict": {
          "type": "string",
          "enum": ["confirmed", "unverified", "contradicted", "stale", "user_confirmed"],
          "description": "user_confirmed=检索不到但用户拍板放行"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source"],
            "properties": {
              "source": { "type": "string", "description": "official / rednote / web_search_generic / doc / user" },
              "date": { "type": "string", "description": "证据发布时间，尽量精确到月" },
              "quote": { "type": "string", "description": "原文引文，供人一眼复核判定" },
              "url": { "type": "string" }
            }
          }
        },
        "checked_at": { "type": "string", "description": "本次核验日期 YYYY-MM-DD；check_freshness.py 据此降级 stale" },
        "effective_from": { "type": "string", "description": "该规则的生效日期（seasonal_road/reservation 类必填）；与行程日期比对：已生效/未生效/行程中途生效（第三种必须高亮）" },
        "affected_days": { "type": "array", "items": { "type": "integer" } }
      }
    }
  }
}
